# Copy to .env and set the URL of your backend API.
VITE_BACKEND_API_URL=http://localhost:5000

# Must match GOOGLE_CLIENT_ID in backend/.env. This is a public client ID;
# never put GOOGLE_CLIENT_SECRET in the frontend.
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Optional; only the public key ID belongs in frontend environment variables.
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id

# Optional public help-contact address.
VITE_SUPPORT_EMAIL=support@example.com

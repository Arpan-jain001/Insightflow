# Copy to .env and replace placeholders with your own values.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/insightflow

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRE=15m
REFRESH_EXPIRE=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email delivery (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret
EMAIL_FROM=InsightFlow <hello@example.com>
SUPPORT_EMAIL=support@example.com

# Optional SMTP/Brevo settings
EMAIL_USER=
EMAIL_PASS=
EMAIL_PORT=587
BREVO_USER=
BREVO_API_KEY=

# AI providers (configure keys for the providers you use)
AI_PROVIDER=GEMINI
AI_FALLBACK_PROVIDER=GEMINI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.2
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_SITE_NAME=InsightFlow
OPENROUTER_SITE_URL=http://localhost:5173

# Admin seed account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=InsightFlow Admin

# Payments (optional)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Optional runtime tuning
CRON_TIMEZONE=Asia/Kolkata
INGEST_RATE_LIMIT_PER_MINUTE=100
